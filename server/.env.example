DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=yunmo
DB_CHARSET=utf8mb4
SECRET_KEY=change_me
TOKEN_EXPIRE_SECONDS=604800
CORS_ORIGINS=*
# 邮件服务：用于发送注册 / 换绑邮箱的验证码。
# 留空 MAIL_USERNAME / MAIL_PASSWORD 时不发信，验证码改为打印到后端控制台（本地开发用）。
# 填上发信账号后自动切换为真实发信，MAIL_PASSWORD 填邮箱的 SMTP 授权码而非登录密码。
MAIL_SERVER=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=番剧同好会
HOST=0.0.0.0
PORT=5000
DEBUG=true